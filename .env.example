# Application and database configuration
MONGO_URL=
DB_NAME=
JWT_SECRET=
BACKEND_PUBLIC_URL=

# Evolution API v2 integration. Keep the API key in the deployment's secret
# manager; never add it to an organisation settings document or the frontend.
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Optional explicit public webhook base. When omitted, BACKEND_PUBLIC_URL is
# used and /api/whatsapp/webhook/{organization_id} is appended automatically.
WHATSAPP_WEBHOOK_URL=
